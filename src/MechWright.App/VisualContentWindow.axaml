<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        xmlns:views="using:MechWright.App.Views"
        x:Class="MechWright.App.VisualContentWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="990" Height="810" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterOwner"
        Title="MechWright · 添加自定义内容"
        Icon="avares://MechWright.App/Assets/brand-chip.png"
        Background="#0B1218" Foreground="#E6ECEB">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="11" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Grid.Column="0" Spacing="5">
        <TextBlock Text="自由添加配置" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="按列表逐项填写；你决定添加什么字段和多少项。原版数据只是参考，不必套用模板。"
                   Foreground="#A7C0BC" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Grid.Column="1" Content="读取 Core / DLC 字段库"
              Click="ScanGame_Click" VerticalAlignment="Center"/>
    </Grid>
    <TabControl Grid.Row="1">
      <TabItem Header="逐项添加字段">
        <Grid RowDefinitions="Auto,*,Auto" Margin="6" RowSpacing="9">
          <Grid Grid.Row="0" ColumnDefinitions="200,*,Auto" ColumnSpacing="9">
            <ComboBox Grid.Column="0" ItemsSource="{Binding ContentCategories}"
                      SelectedItem="{Binding SelectedContentCategory,Mode=TwoWay}"
                      MinHeight="38">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContentCategoryRow">
                  <TextBlock Text="{Binding Title}" FontSize="12"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Text="{Binding ContentSearch,Mode=TwoWay}"
                     Watermark="搜索字段名称或用途" MinHeight="38"/>
            <CheckBox Grid.Column="2" Content="包含原版更多字段"
                      IsChecked="{Binding ShowObservedContent,Mode=TwoWay}"
                      VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="9">
              <TextBlock Text="找到一个设置，在同一行填写并保存；不需要先选模板。"
                         FontSize="11" Foreground="#8EABB0" Margin="3,6"/>
              <ItemsControl ItemsSource="{Binding ContentAvailableRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorksheetFieldRow">
                    <Border Background="#17272E" BorderBrush="#30464B"
                            BorderThickness="1" CornerRadius="7" Padding="11">
                      <Grid ColumnDefinitions="220,*,98" ColumnSpacing="13">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     TextWrapping="Wrap" ToolTip.Tip="{Binding Hint}"/>
                          <TextBlock Text="{Binding CurrentStatus}" Foreground="#8DAAAE"
                                     FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" MinHeight="36" VerticalAlignment="Center">
                          <NumericUpDown IsVisible="{Binding IsNumber}" Minimum="-999999999"
                                         Maximum="999999999" Increment="1" FormatString="N2"
                                         Value="{Binding Number,Mode=TwoWay}"/>
                          <TextBox IsVisible="{Binding IsText}" Text="{Binding Text,Mode=TwoWay}"/>
                          <CheckBox IsVisible="{Binding IsBoolean}" Content="启用"
                                    IsChecked="{Binding Boolean,Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                          <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}"
                                    SelectedItem="{Binding Choice,Mode=TwoWay}" MinHeight="36"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                          <Button Content="写入" Classes="primary" Click="SaveFieldRow_Click"
                                  MinHeight="28"/>
                          <Button Content="移除" IsEnabled="{Binding CanReset}"
                                  Click="RemoveFieldRow_Click" MinHeight="27"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="没有想要的字段？使用下方的“自定义字段”，或切换到“自建多项结构”。"
                         Foreground="#91ABB0" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#192D30" BorderBrush="#3A555B"
                  BorderThickness="1" CornerRadius="8" Padding="13">
            <StackPanel Spacing="9">
              <TextBlock Text="自定义字段 · 不依赖任何模板" FontSize="14" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="170,155,*,148" ColumnSpacing="9">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="目标定义" Foreground="#A9B9BB" FontSize="11"/>
                  <ComboBox ItemsSource="{Binding FreeformTargets}"
                            SelectedItem="{Binding SelectedContentCustomTarget,Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FreeformTargetRow">
                        <TextBlock Text="{Binding Label}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="所在分组" Foreground="#A9B9BB" FontSize="11"/>
                  <TextBox Text="{Binding ContentCustomParent,Mode=TwoWay}"
                           Watermark="statBases"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                  <TextBlock Text="字段名称" Foreground="#A9B9BB" FontSize="11"/>
                  <TextBox Text="{Binding ContentCustomName,Mode=TwoWay}"
                           Watermark="例如：MoveSpeed"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="5">
                  <TextBlock Text="值类型" Foreground="#A9B9BB" FontSize="11"/>
                  <ComboBox ItemsSource="{Binding ContentCustomKinds}"
                            SelectedItem="{Binding ContentCustomKind,Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                <TextBox Grid.Column="0" Text="{Binding ContentCustomValue,Mode=TwoWay}"
                         Watermark="输入该字段的值" MinHeight="38"/>
                <Button Grid.Column="1" Content="添加自定义字段" Classes="primary"
                        Click="AddCustomField_Click"/>
              </Grid>
              <TextBlock Text="提示：留空分组或输入“根目录”代表顶层；自定义字段仅保证 XML 结构可写，字段是否被游戏支持需要验证。"
                         FontSize="11" Foreground="#D0B485" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="自建多项结构">
        <views:VisualModuleBuilderView/>
      </TabItem>
      <TabItem Header="新建其他定义">
        <views:VisualDefinitionBuilderView/>
      </TabItem>
      <TabItem Header="可选 · 引用原版配置">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="11">
          <TextBlock Grid.Row="0" Text="仅作为参考：可以复制本机原版的组件或攻击项，再自由修改内部字段。"
                     TextWrapping="Wrap" Foreground="#9FB9BD" FontSize="12"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding ContentTemplates}"
                   SelectedItem="{Binding SelectedContentTemplate,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContentTemplateRow">
                <Border Background="#16262D" CornerRadius="6" Margin="3,3" Padding="11">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#99B4B5"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" Classes="primary" Content="复制选中项到当前机械体"
                  IsEnabled="{Binding ContentHasTemplate}" Click="InstallModule_Click"
                  HorizontalAlignment="Right"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="9">
      <Border Grid.Column="0" Background="#15302E" CornerRadius="7" Padding="12">
        <TextBlock Text="{Binding ContentStatus}" Foreground="#B2D9D0"
                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Border>
      <Button Grid.Column="1" Content="返回设计" Classes="primary"
              Click="Close_Click" MinWidth="115"/>
    </Grid>
  </Grid>
</Window>