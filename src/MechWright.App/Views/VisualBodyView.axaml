<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MechWright.App.ViewModels"
             x:Class="MechWright.App.Views.VisualBodyView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="14,12,23,24">
      <StackPanel Spacing="5">
        <TextBlock Text="身体结构 · 自由装配" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="从核心开始逐个添加子部件。没有固定的身体模板，可以任意设计层级、覆盖率、位置和部件名称。"
                   Foreground="#9CB7B8" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Classes="feature-card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="一、当前身体结构" FontSize="15" Foreground="#B7D8CE"
                     FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding BodyParts}"
                   SelectedItem="{Binding SelectedBodyPart,Mode=TwoWay}"
                   MinHeight="80" MaxHeight="310">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BodyRow">
                <Border Margin="3,2" Padding="11" Background="#172931"
                        BorderBrush="#2F454C" BorderThickness="1" CornerRadius="7">
                  <Grid ColumnDefinitions="34,*,120" ColumnSpacing="12">
                    <Border Background="#294347" CornerRadius="6" Width="31" Height="31">
                      <PathIcon Data="M12 2L21 7V17L12 22L3 17V7ZM3 7L12 12L21 7"
                                Width="19" Height="19" Foreground="#9FD0C3"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 TextWrapping="Wrap"/>
                      <ProgressBar Minimum="0" Maximum="100"
                                   Value="{Binding EffectivePercent}" Height="5"
                                   Foreground="#7EBDB1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Effective}" FontSize="12"
                                 Foreground="#B2DAD0" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding Layers}" FontSize="10"
                                 Foreground="#8DA5AC" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="选择某个部件后，下方可以修改它，或在它下面安装新部件。"
                     FontSize="11" Foreground="#8EA6AC" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Classes="feature-card" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="二、编辑选中部件" FontSize="15" FontWeight="SemiBold"
                     Foreground="#B7D8CE"/>
          <Grid ColumnDefinitions="190,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="部件 DefName"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PartDefName,Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="自定义显示名称"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PartCustomLabel,Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="相对覆盖率（0–1）"
                       VerticalAlignment="Center" FontSize="12"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="0.01" Maximum="1" Increment="0.01" FormatString="N3"
                           Value="{Binding VisualPartCoverage,Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="部件高度"
                       VerticalAlignment="Center" FontSize="12"/>
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Heights}"
                      SelectedItem="{Binding PartHeight,Mode=TwoWay}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="内部或外部"
                       VerticalAlignment="Center" FontSize="12"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Depths}"
                      SelectedItem="{Binding PartDepth,Mode=TwoWay}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="保存部件配置" Classes="primary"
                    Click="ApplyCoverage_Click" IsEnabled="{Binding HasBodyPart}"/>
            <Button Content="移除选中部件" Click="RemovePart_Click"
                    IsEnabled="{Binding CanRemoveBodyPart}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="feature-card" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="三、在选中部件下添加新的子部件"
                     FontSize="15" FontWeight="SemiBold" Foreground="#B7D8CE"/>
          <TextBlock Text="直接填写你要用的部件名。名称应引用已存在的 BodyPartDef，也可以在工程内另行创建自定义 BodyPartDef。"
                     FontSize="11" Foreground="#9FB4B5" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="子部件 DefName"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewPartDefName,Mode=TwoWay}"
                     Watermark="例如 MechanicalArm"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="覆盖率"
                       VerticalAlignment="Center" FontSize="12"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0.01"
                           Maximum="1" Increment="0.01" FormatString="N3"
                           Value="{Binding VisualNewPartCoverage,Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="部件高度"
                       VerticalAlignment="Center" FontSize="12"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Heights}"
                      SelectedItem="{Binding NewPartHeight,Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="内部或外部"
                       VerticalAlignment="Center" FontSize="12"/>
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Depths}"
                      SelectedItem="{Binding NewPartDepth,Mode=TwoWay}"/>
          </Grid>
          <Button Content="＋ 添加子部件" Click="AddCustomBodyPart_Click"
                  Classes="primary" IsEnabled="{Binding HasBodyPart}"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Expander Header="可选：从已安装原版机械体复制身体结构" IsExpanded="False">
        <Border Padding="13" Background="#1B2D33" CornerRadius="7">
          <StackPanel Spacing="10">
            <TextBlock Text="这一操作会替换当前的身体树。仅当你主动选择复制时才执行。"
                       Foreground="#D6B887" FontSize="11" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding BodyTemplateCards}"
                      SelectedItem="{Binding SelectedBodyTemplate,Mode=TwoWay}"
                      MaxDropDownHeight="250">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VisualBodyTemplateRow">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Button Content="读取原版目录" Click="ConnectGame_Click"/>
              <Button Content="确认复制此结构" Click="ApplyBodyTemplate_Click"
                      IsEnabled="{Binding HasBodyTemplates}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>