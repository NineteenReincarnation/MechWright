<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MechWright.App.ViewModels"
             x:Class="MechWright.App.Views.VisualWorksheetView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,7,23,25" Spacing="13">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,4">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Text="机械体配置清单" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="按顺序填写或修改每个参数。没有必选的机体模板，每一项都可单独保存。"
                     FontSize="12" Foreground="#9BB6B8" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Click="AddField_Click"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="M12 4V20M4 12H20" Width="16" Height="16"/>
            <TextBlock Text="添加配置项"/>
          </StackPanel>
        </Button>
      </Grid>
      <Border IsVisible="{Binding WorksheetCatalogOpen}" CornerRadius="8"
              BorderBrush="#36595A" BorderThickness="1" Background="#162B2F" Padding="13">
        <StackPanel Spacing="10">
          <TextBlock Text="选择字段，加入当前配置清单" FontSize="15"
                     FontWeight="SemiBold" Foreground="#C0DDD4"/>
          <Grid ColumnDefinitions="158,*,Auto" ColumnSpacing="9">
            <ComboBox Grid.Column="0" ItemsSource="{Binding WorksheetCatalogCategories}"
                      SelectedItem="{Binding WorksheetCatalogCategory,Mode=TwoWay}"
                      MinHeight="36"/>
            <TextBox Grid.Column="1" Watermark="按名称、功能或字段搜索"
                     Text="{Binding WorksheetCatalogSearch,Mode=TwoWay}" MinHeight="36"/>
            <Button Grid.Column="2" Content="读取游戏字段库"
                    Click="ScanFields_Click" MinHeight="36"/>
          </Grid>
          <TextBlock Text="{Binding WorksheetCatalogCount}" FontSize="11"
                     Foreground="#9BB9B3"/>
          <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding WorksheetCatalogRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="5"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorksheetCatalogRow">
                  <Border Background="#102228" BorderBrush="#345154"
                          BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="180,*,90" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Category}" FontSize="10"
                                   Foreground="#9CB8B0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                   Foreground="#B1C4C2" FontSize="11" MaxLines="2"
                                   ToolTip.Tip="{Binding Path}"/>
                        <TextBlock Text="{Binding Source}" Foreground="#85A7A9"
                                   FontSize="10" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="2" Content="添加" Classes="primary"
                              Click="AddCatalogRow_Click" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Expander Header="自定义未收录字段（高级）" Margin="0,7,0,0">
            <StackPanel Spacing="10" Margin="5,12,5,5">
              <TextBlock Text="只有字段库里找不到需要的配置时才使用。这里填写的是原生字段名，不能保证游戏接受任意自定义属性。"
                         TextWrapping="Wrap" Foreground="#D2B98B" FontSize="11"/>
              <Grid ColumnDefinitions="170,170,*,125" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="属于哪份定义" FontSize="11"/>
                  <ComboBox ItemsSource="{Binding FreeformTargets}"
                            SelectedItem="{Binding SelectedContentCustomTarget,Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FreeformTargetRow">
                        <TextBlock Text="{Binding Label}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="所在分组" FontSize="11"/>
                  <TextBox Text="{Binding ContentCustomParent,Mode=TwoWay}"
                           Watermark="例如 statBases"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="原生字段名称" FontSize="11"/>
                  <TextBox Text="{Binding ContentCustomName,Mode=TwoWay}"
                           Watermark="例如 MoveSpeed"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                  <TextBlock Text="值类型" FontSize="11"/>
                  <ComboBox ItemsSource="{Binding ContentCustomKinds}"
                            SelectedItem="{Binding ContentCustomKind,Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                <TextBox Grid.Column="0" Text="{Binding ContentCustomValue,Mode=TwoWay}"
                         Watermark="请输入该字段的值" MinHeight="35"/>
                <Button Grid.Column="1" Content="写入自定义字段"
                        Classes="primary" Click="SaveCustomField_Click"/>
              </Grid>
            </StackPanel>
          </Expander>
          <TextBlock Text="添加只创建待填写行，不会直接修改 XML；保存对应行后才写入工程。"
                     Foreground="#9BB6B8" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border CornerRadius="7" Background="#18292F" Padding="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <TextBox Grid.Column="0" Watermark="查找已显示的字段"
                   Text="{Binding WorksheetSearch,Mode=TwoWay}" MinHeight="36"/>
          <TextBlock Grid.Column="1" Text="{Binding WorksheetCount}"
                     VerticalAlignment="Center" Foreground="#94B8B3" FontSize="11"/>
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding WorksheetFields}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="5"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorksheetFieldRow">
            <StackPanel Spacing="7">
              <Border IsVisible="{Binding ShowCategoryHeader}" Margin="0,13,0,6"
                      BorderBrush="#426367" BorderThickness="0,0,0,1" Padding="4,5,0,11">
                <TextBlock Text="{Binding Category}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#B2D8CD"/>
              </Border>
              <Border BorderThickness="1" BorderBrush="#2F454C"
                      CornerRadius="7" Background="#131F26" Padding="13">
                <Grid ColumnDefinitions="215,*,112" ColumnSpacing="14">
                  <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" ToolTip.Tip="{Binding Hint}"/>
                    <TextBlock Text="{Binding CurrentStatus}" FontSize="10"
                               Foreground="#95B8AC" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                               Foreground="#829DA6"/>
                  </StackPanel>
                  <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="38">
                    <NumericUpDown IsVisible="{Binding IsNumber}"
                                   Value="{Binding Number,Mode=TwoWay}"
                                   Minimum="-999999999" Maximum="999999999"
                                   FormatString="0.########" Increment="1"/>
                    <CheckBox IsVisible="{Binding IsBoolean}" Content="启用"
                              IsChecked="{Binding Boolean,Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding Choice,Mode=TwoWay}" MinHeight="38"/>
                    <TextBox IsVisible="{Binding IsText}" MinHeight="38"
                             Text="{Binding Text,Mode=TwoWay}"/>
                  </Grid>
                  <StackPanel Grid.Column="2" Spacing="7"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button Content="保存" Classes="primary"
                            Click="SaveRow_Click" MinHeight="31"/>
                    <Button Content="恢复继承" Click="ResetRow_Click"
                            IsVisible="{Binding !IsPinned}"
                            IsEnabled="{Binding CanReset}" MinHeight="30"/>
                    <Button Content="移除待填写" Click="DiscardRow_Click"
                            IsVisible="{Binding IsPinned}" MinHeight="30"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#122A29" CornerRadius="7" Padding="13" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding WorksheetMessage}" TextWrapping="Wrap"
                     Foreground="#B4D7CD" VerticalAlignment="Center" FontSize="12"/>
          <Button Grid.Column="1" Click="AddField_Click"
                  Content="＋ 添加任意其他原生字段" Classes="primary"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>