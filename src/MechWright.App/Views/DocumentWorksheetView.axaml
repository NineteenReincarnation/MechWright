<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MechWright.App.ViewModels"
             x:Class="MechWright.App.Views.DocumentWorksheetView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*" Background="#181D23">
    <Border Grid.Row="0" Padding="23,13" Background="#20262D"
            BorderBrush="#35404A" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DocumentFileTitle}" FontSize="11"
                   Foreground="#93A6AE"/>
        <TextBlock Text="{Binding DocumentObjectKind}" FontSize="18"
                   FontWeight="SemiBold" Foreground="#E8EFEE"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" x:Name="MainScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,18,38,34" Spacing="15" MaxWidth="1100"
                  HorizontalAlignment="Stretch">
        <!-- Imported empty XML and new blank workspaces need only one action. -->
        <StackPanel IsVisible="{Binding DocumentIsEmpty}" Spacing="12"
                    Margin="0,52,0,0" HorizontalAlignment="Center">
          <TextBlock Text="开始填写配置" FontSize="20" FontWeight="SemiBold"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="从第一项直接填写，无需先选择字段或建立模板。"
                     Foreground="#A2B3B8" FontSize="12"/>
          <Button Content="开始填写机械体属性" Classes="primary"
                  Click="StartBlank_Click" MinHeight="44"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding DocumentHasDefinition}" Spacing="7">
          <TextBlock Text="基本信息" FontSize="14" FontWeight="SemiBold"
                     Foreground="#A8CCC1" Margin="0,4,0,5"/>
          <Grid ColumnDefinitions="180,*" ColumnSpacing="18" MinHeight="42">
            <TextBlock Grid.Column="0" Text="定义标识" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13"/>
            <TextBox Grid.Column="1" x:Name="IdentityEditor"
                     Text="{Binding InlineIdentityDraft,Mode=TwoWay}"
                     LostFocus="CommitIdentity_LostFocus"
                     PlaceholderText="MP_Thing001" MinHeight="40"
                     ToolTip.Tip="Mod 中唯一的定义标识，以 MP_ 开头"/>
          </Grid>
          <Grid ColumnDefinitions="180,*" ColumnSpacing="18" MinHeight="42">
            <TextBlock Grid.Column="0" Text="显示名称" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13"/>
            <TextBox Grid.Column="1" x:Name="LabelEditor"
                     Text="{Binding DocumentLabelDraft,Mode=TwoWay}"
                     LostFocus="SaveLabel_LostFocus"
                     PlaceholderText="在游戏中显示的名称" MinHeight="40"/>
          </Grid>

          <Border Height="1" Background="#35404A" Margin="0,15,0,6"/>
          <TextBox x:Name="InlineSearchBox"
                   Text="{Binding InlineSearch,Mode=TwoWay}"
                   PlaceholderText="查找或直接填写更多属性，例如速度、护甲、射程…"
                   MinHeight="39" MaxWidth="590"
                   HorizontalAlignment="Left" Margin="0,0,0,7"/>

          <!-- Every known property is an editor, regardless of whether its
               XML node exists. Empty optional properties never write nodes. -->
          <ItemsControl ItemsSource="{Binding InlineInspectorRows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="0"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InlineInspectorRow">
                <StackPanel Spacing="0">
                  <TextBlock Text="{Binding Category}" IsVisible="{Binding ShowCategory}"
                             Foreground="#A8CCC1" FontWeight="SemiBold" FontSize="14"
                             Margin="0,17,0,11"/>
                  <Border Background="Transparent" BorderBrush="#34404A"
                          BorderThickness="0,0,0,1" Padding="0,7">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="18"
                          MinHeight="42">
                      <TextBlock Grid.Column="0" Text="{Binding Title}"
                                 VerticalAlignment="Center" FontSize="13"
                                 ToolTip.Tip="{Binding Hint}" TextWrapping="Wrap"/>
                      <Grid Grid.Column="1" MinHeight="37"
                            VerticalAlignment="Center">
                        <TextBox Text="{Binding Text,Mode=TwoWay}"
                                 IsVisible="{Binding IsText}"
                                 LostFocus="CommitInline_LostFocus"
                                 PlaceholderText="留空则不设置此项" MinHeight="37"/>
                        <NumericUpDown Value="{Binding Number,Mode=TwoWay}"
                                       IsVisible="{Binding IsNumber}"
                                       LostFocus="CommitInline_LostFocus"
                                       Minimum="-999999999" Maximum="999999999"
                                       Increment="1" FormatString="0.########"
                                       MinHeight="37"/>
                        <CheckBox IsChecked="{Binding Boolean,Mode=TwoWay}"
                                  IsVisible="{Binding IsBoolean}"
                                  Click="CommitInlineBoolean_Click"
                                  IsThreeState="True"
                                  Content="启用（可留空）" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding Choice,Mode=TwoWay}"
                                  SelectionChanged="CommitInlineChoice_SelectionChanged"
                                  IsVisible="{Binding IsChoice}"
                                  MinHeight="37"/>
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding InlineMessage}" FontSize="12"
                     Foreground="#D6AE99" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock Text="直接填写即可。未填写的可选项不会写进 XML；最终通过顶部保存文件。"
                     Foreground="#8098A2" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Complex structures and extra Def types are accessible, but never
             obstruct the normal top-to-bottom typing workflow. -->
        <Border Height="1" Background="#35404A" Margin="0,14,0,0"/>
        <Button Content="复杂结构与其他定义…" Click="ToggleAdvanced_Click"
                HorizontalAlignment="Left" MinHeight="33"/>
        <StackPanel IsVisible="{Binding InlineAdvancedOpen}" Spacing="18"
                    Margin="0,0,0,18">
          <Border Background="#222C34" BorderBrush="#3D4C55"
                  BorderThickness="1" CornerRadius="7" Padding="17">
            <StackPanel Spacing="11">
              <TextBlock Text="在当前 XML 中添加其他定义" FontSize="14"
                         FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="210,*,*" ColumnSpacing="10">
                <ComboBox Grid.Column="0" ItemsSource="{Binding DocumentDefinitionTypes}"
                          SelectedItem="{Binding DocumentSelectedType,Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentDefTypeChoice">
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Text="{Binding DocumentDefName,Mode=TwoWay}"
                         PlaceholderText="MP_定义标识"/>
                <TextBox Grid.Column="2" Text="{Binding DocumentDefLabel,Mode=TwoWay}"
                         PlaceholderText="显示名称（可选）"/>
              </Grid>
              <Button Content="添加此定义" Click="AppendDefinition_Click"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border Background="#222C34" BorderBrush="#3D4C55"
                  BorderThickness="1" CornerRadius="7" Padding="17"
                  IsVisible="{Binding DocumentHasDefinition}">
            <StackPanel Spacing="11">
              <TextBlock Text="列表项与复杂嵌套结构" FontSize="14"
                         FontWeight="SemiBold"/>
              <TextBlock Text="只有身体部件、武器列表、组件等需要复杂结构时才用这里。"
                         FontSize="11" Foreground="#9BB1B7"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <ComboBox Grid.Column="0" ItemsSource="{Binding DocumentNodes}"
                          SelectedItem="{Binding DocumentSelectedNode,Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentNodeRow">
                      <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DocumentFieldChoices}"
                          SelectedItem="{Binding DocumentSelectedField,Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentFieldChoice">
                      <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Text="{Binding DocumentInsertLocation}" Foreground="#9FB3BA"
                         FontSize="11"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Text="{Binding DocumentNewValue,Mode=TwoWay}"
                         PlaceholderText="节点值（分组留空）" MinHeight="38"/>
                <Button Grid.Column="1" Content="添加子项" Click="AddField_Click"/>
              </Grid>
              <StackPanel IsVisible="{Binding DocumentUsesCustomName}" Spacing="7">
                <TextBox Text="{Binding DocumentCustomFieldName,Mode=TwoWay}"
                         PlaceholderText="自定义 XML 字段名"/>
                <CheckBox Content="创建可展开的分组"
                          IsChecked="{Binding DocumentCustomIsGroup,Mode=TwoWay}"/>
              </StackPanel>
              <Button Content="删除选中节点" Click="RemoveSelectedNode_Click"
                      IsEnabled="{Binding DocumentHasNodes}"
                      HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding DocumentMessage}" FontSize="11"
                         Foreground="#9EBDC0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>