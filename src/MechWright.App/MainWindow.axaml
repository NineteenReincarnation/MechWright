<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        xmlns:views="using:MechWright.App.Views"
        x:Class="MechWright.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MechWright · 机械体设计工作台"
        Width="1440" Height="880" MinWidth="1020" MinHeight="660"
        Icon="avares://MechWright.App/Assets/brand-chip.png"
        Background="#161C22" Foreground="#F0F2F2">
  <Grid RowDefinitions="68,*,35">
    <Border Grid.Row="0" Background="#20262E" BorderBrush="#35404A"
            BorderThickness="0,0,0,1" Padding="19,11">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="17">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <Image Source="avares://MechWright.App/Assets/brand-chip.png"
                 Width="27" Height="27"/>
          <StackPanel Spacing="2">
            <TextBlock Text="MechWright" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="机械体设计工作台 · RimWorld 1.7"
                       FontSize="10" Foreground="#8FA7AD"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="＋ 新建" Classes="primary" Click="NewFile_Click"/>
          <Button Content="打开文件" Click="OpenFile_Click"/>
          <Button Content="导入 Mod" Click="ImportWorkspace_Click"/>
          <Button Content="保存 XML" Click="Export_Click"
                  IsEnabled="{Binding HasDocument}"/>
          <Button Content="导出 Mod" Click="ExportWorkspace_Click"
                  IsVisible="{Binding HasWorkspace}"/>
          <Border Width="1" Background="#43505B" Margin="4,6"/>
          <Button Content="撤销" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
          <Button Content="重做" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" IsVisible="{Binding ShowStartPage}"
          Margin="40">
      <StackPanel MaxWidth="700" Spacing="19"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="avares://MechWright.App/Assets/brand-chip.png"
               Width="70" Height="70" HorizontalAlignment="Center"/>
        <TextBlock Text="设计，从一个空白文件开始" FontSize="28"
                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="不用懂 XML，也不用先填写十几个参数。选择要做的内容，按列表添加和修改即可。"
                   FontSize="14" Foreground="#A2B1BB"
                   TextWrapping="Wrap" TextAlignment="Center"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="11" Margin="0,14,0,0">
          <Button Grid.Column="0" Content="＋ 新建空白文件"
                  Classes="primary" Click="NewFile_Click" MinHeight="54"/>
          <Button Grid.Column="1" Content="打开已有 XML"
                  Click="OpenFile_Click" MinHeight="54"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
          <Button Content="导入整个 Mod 工程" Click="ImportWorkspace_Click"/>
          <Button Content="新建多文件工程" Click="NewWorkspace_Click"/>
          <Button Content="查看原版机械体" Click="OpenVanillaLibrary_Click"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" IsVisible="{Binding ShowWorkspacePage}"
          ColumnDefinitions="248,*" ColumnSpacing="0">
      <Border Grid.Column="0" Background="#1B2229"
              BorderBrush="#36414A" BorderThickness="0,0,1,0">
        <Grid Margin="16,17" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              RowSpacing="11">
          <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="文件" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{Binding SourceName}" Foreground="#97A8B1"
                       TextWrapping="Wrap" FontSize="11" MaxLines="3"/>
            <TextBlock Text="{Binding DirtyFlag}" FontSize="11"
                       Foreground="#92BEB3"/>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding ProjectFiles}"
                   SelectedItem="{Binding SelectedProjectFile,Mode=TwoWay}"
                   IsVisible="{Binding HasWorkspace}" MaxHeight="176"
                   Background="#1E2830">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectFileRow">
                <TextBlock Text="{Binding Display}" FontSize="11"
                           TextWrapping="Wrap" Margin="4,5"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="当前文件的内容" FontWeight="SemiBold"
                       FontSize="13" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="＋" Click="AddDefinitionInline_Click"
                    ToolTip.Tip="添加另一项内容" Padding="8,3"/>
          </Grid>
          <Border Grid.Row="3" Background="#36414A" Height="1"/>
          <ListBox Grid.Row="4" ItemsSource="{Binding Definitions}"
                   SelectedItem="{Binding SelectedDefinition,Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent"
                   HorizontalAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DefinitionRow">
                <StackPanel Margin="7,7" Spacing="4">
                  <TextBlock Text="{Binding FriendlyTitle}" FontSize="12"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TechnicalId}" FontSize="10"
                             Foreground="#90A4AD" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="5" Spacing="8">
            <Button Content="＋ 新增工程文件" Click="AddProjectXml_Click"
                    IsVisible="{Binding HasWorkspace}"/>
            <Button Content="连接本机游戏字段" Click="ConnectGameSchema_Click"/>
            <TextBlock Text="{Binding DocumentSchemaStatus}" FontSize="10"
                       Foreground="#91A7B0" TextWrapping="Wrap"/>
            <Button Content="原版机械体图鉴" Click="OpenVanillaLibrary_Click"/>
            <Button Content="查看 XML 源码" Click="EditRaw_Click"/>
            <Button Content="机械体专项工具" Click="SwitchToGuided_Click"
                    IsVisible="{Binding IsDocumentMode}"/>
            <Button Content="返回配置列表" Click="SwitchToDocument_Click"
                    IsVisible="{Binding IsGuidedMode}"/>
          </StackPanel>
        </Grid>
      </Border>

      <views:DocumentWorksheetView Grid.Column="1" IsVisible="{Binding IsDocumentMode}"/>
      <Grid Grid.Column="1" IsVisible="{Binding IsGuidedMode}"
            RowDefinitions="Auto,*" Margin="20,12" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="机械体专项工具" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="高级身体、战斗与资源编辑仍可使用，普通配置无需进入这里。"
                       Foreground="#9FB0B7" FontSize="12"/>
          </StackPanel>
          <Button Grid.Column="1" Content="返回列表" Click="SwitchToDocument_Click"
                  VerticalAlignment="Center"/>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding WorkflowStep,Mode=TwoWay}">
          <TabItem Header="基本属性">
            <views:VisualWorksheetView/>
          </TabItem>
          <TabItem Header="身体与外观">
            <TabControl>
              <TabItem Header="身体结构"><views:VisualBodyView/></TabItem>
              <TabItem Header="方向贴图"><views:VisualGraphicView/></TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="战斗">
            <views:VisualModuleBuilderView/>
          </TabItem>
          <TabItem Header="培育与资源">
            <TabControl>
              <TabItem Header="机械培育"><views:VisualGestationView/></TabItem>
              <TabItem Header="工程资源"><views:VisualAssetsView/></TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="检查与导出">
            <views:VisualReviewView/>
          </TabItem>
          <TabItem Header="其他定义">
            <views:VisualDefinitionBuilderView/>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#20262E" BorderBrush="#35404A"
            BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11"
                   Foreground="#98A9B2" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding DiagnosticCount}" FontSize="11"
                   Foreground="#A5B5B9"/>
      </Grid>
    </Border>
  </Grid>
</Window>