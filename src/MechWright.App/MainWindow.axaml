<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        x:Class="MechWright.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MechWright · MECHANOID DESIGN SYSTEM"
        Width="1440" Height="900" MinWidth="1050" MinHeight="660"
        Icon="avares://MechWright.App/Assets/brand-chip.png"
        Background="#0B1014"
        Foreground="#E6ECEB">

  <Grid RowDefinitions="99,*,154,32">
    <!-- Single responsive command rail. Tools remain keyboard reachable at narrow widths. -->
    <Border Grid.Row="0" BorderBrush="#33434B" BorderThickness="0,0,0,1" Background="#121B21" Padding="15,7">
      <Grid RowDefinitions="31,43" RowSpacing="4">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://MechWright.App/Assets/brand-chip.png" Width="24" Height="24"/>
          <TextBlock Text="MECHWRIGHT" FontWeight="Bold" FontSize="17" LetterSpacing="2" VerticalAlignment="Center"/>
          <TextBlock Text=" / RIMWORLD 1.7 / MECHANOID DESIGN SYSTEM" FontSize="10" Foreground="#8DBCB4" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button Content="新建工程" Click="NewWorkspace_Click"/>
            <Button Content="导入 Mod 工程" Click="ImportWorkspace_Click"/>
            <Button Content="导出工程 XML" Click="ExportWorkspace_Click" Background="#32585C"/>
            <Border Width="1" Background="#384B54" Margin="5,5"/>
            <Button Content="新建 XML" Click="NewFile_Click"/>
            <Button Content="打开 XML" Click="OpenFile_Click"/>
            <Button Content="编辑源码" Click="EditRaw_Click"/>
            <Button Content="原版机械体图鉴" Click="OpenVanillaLibrary_Click" Background="#28535A"/>
          <Button Content="原版 / DLC 目录" Click="ScanCatalog_Click"/>
            <Button Content="撤销" Click="Undo_Click"/>
            <Button Content="重做" Click="Redo_Click"/>
            <Button Content="导出当前 XML" Click="Export_Click"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="310,*,350" Margin="10,10,10,0" ColumnSpacing="10">
      <!-- Project navigation and local read-only reference index. -->
      <Border Grid.Column="0" Background="#151E24" CornerRadius="7" BorderBrush="#293C44" BorderThickness="1">
        <Grid RowDefinitions="Auto,90,Auto,Auto,Auto,Auto,*,Auto,Auto,*,Auto" Margin="12">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,2,0,7">
            <TextBlock Text="01   工程文件 / PROJECT FILES" FontSize="12" FontWeight="Bold" Foreground="#8DBCB4"/>
            <TextBlock Text="{Binding WorkspaceTitle}" FontSize="11" Foreground="#A3B1B4" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding ProjectFiles}" SelectedItem="{Binding SelectedProjectFile,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectFileRow">
                <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="4,4"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox Grid.Row="2" PlaceholderText="1.7/Defs/NewDefs.xml"
                   Text="{Binding NewProjectXmlPath,Mode=TwoWay}" Margin="0,7,0,5"/>
          <Button Grid.Row="3" Content="＋ 添加工程 XML" Click="AddProjectXml_Click"
                  IsEnabled="{Binding HasWorkspace}" Margin="0,0,0,9"/>
          <TextBlock Grid.Row="4" Text="02   当前文件 / DEF BROWSER" FontSize="12" FontWeight="Bold"
                     Foreground="#8DBCB4" Margin="0,2,0,8"/>
          <TextBox Grid.Row="5" PlaceholderText="筛选当前 XML 定义" Text="{Binding SearchQuery,Mode=TwoWay}" Margin="0,0,0,5"/>
          <ListBox Grid.Row="6" ItemsSource="{Binding VisibleDefinitions}" SelectedItem="{Binding SelectedDefinition,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DefinitionRow">
                <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap" Margin="4,6"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="7" Margin="0,8,0,9" Height="1" Background="#30424A"/>
          <TextBlock Grid.Row="8" Text="03   本机原版 / DLC 定义" FontSize="12" FontWeight="Bold"
                     Foreground="#8DBCB4" Margin="0,2,0,8"/>
          <Grid Grid.Row="9" RowDefinitions="Auto,*">
            <TextBox Grid.Row="0" PlaceholderText="筛选游戏定义" Text="{Binding CatalogQuery,Mode=TwoWay}" Margin="0,0,0,5"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding VisibleCatalog}" SelectedItem="{Binding SelectedCatalog,Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogRow">
                  <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="4,5"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Button Grid.Row="10" Content="打开所选原版定义" Click="OpenCatalog_Click" Margin="0,7,0,0"/>
        </Grid>
      </Border>

      <!-- Real, synchronized XML and body representations. -->
      <Border Grid.Column="1" Background="#151E24" CornerRadius="7" BorderBrush="#293C44" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*" Margin="14">
          <StackPanel Grid.Row="0" Spacing="6" Margin="0,2,0,12">
            <TextBlock Text="工程工作台 / DEFINITION WORKSPACE" FontWeight="Bold" FontSize="12" Foreground="#8DBCB4"/>
            <TextBlock Text="{Binding SourceName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SelectedDefName}" FontSize="12" Foreground="#CFB482" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Grid.Row="1" Height="1" Background="#30424A" Margin="0,0,0,8"/>
          <TabControl Grid.Row="2" x:Name="WorkspaceTabs">
            <TabItem Header="原版机械体图鉴">
              <Grid RowDefinitions="Auto,Auto,*" Margin="7" RowSpacing="7">
                <TextBlock Grid.Row="0" Text="{Binding VanillaStatus}"
                           FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,5"/>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding VanillaPackages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VanillaPackageRow">
                        <Border Background="#26333C" BorderBrush="#354850" BorderThickness="1"
                                CornerRadius="4" Padding="6,4">
                          <TextBlock Text="{Binding Display}" FontSize="10" FontFamily="Consolas"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnDefinitions="218,*" ColumnSpacing="9">
                  <Border Grid.Column="0" Background="#101A21" BorderBrush="#34454D"
                          BorderThickness="1" CornerRadius="5">
                    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="6">
                      <TextBlock Grid.Row="0" Text="{Binding VanillaCount}" FontSize="12"
                                 Foreground="#8DBCB4" FontWeight="SemiBold"/>
                      <TextBox Grid.Row="1" Text="{Binding VanillaSearch,Mode=TwoWay}"
                               PlaceholderText="名称 / DefName / 描述"/>
                      <ComboBox Grid.Row="2" ItemsSource="{Binding VanillaPackageFilters}"
                                SelectedItem="{Binding VanillaPackage,Mode=TwoWay}"/>
                      <ComboBox Grid.Row="3" ItemsSource="{Binding VanillaWeightFilters}"
                                SelectedItem="{Binding VanillaWeight,Mode=TwoWay}"/>
                      <ListBox Grid.Row="4" ItemsSource="{Binding VisibleVanillaMechs}"
                               SelectedItem="{Binding SelectedVanillaMech,Mode=TwoWay}"
                               ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:VanillaMechSummaryRow">
                            <StackPanel Spacing="3" Margin="4,6">
                              <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Meta}" Foreground="#8DBCB4"
                                         FontSize="10" FontFamily="Consolas"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Background="#101A21" BorderBrush="#34454D"
                          BorderThickness="1" CornerRadius="5">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="10" RowSpacing="7">
                      <StackPanel Grid.Row="0" Spacing="5">
                        <TextBlock Text="{Binding VanillaTitle}" FontSize="16" FontWeight="Bold"
                                   Foreground="#E6ECEB" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding VanillaSource}" FontSize="10"
                                   Foreground="#8DBCB4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VanillaDescription}" FontSize="11"
                                   Foreground="#A3B1B4" TextWrapping="Wrap" MaxHeight="58"/>
                      </StackPanel>
                      <Border Grid.Row="1" Height="1" Background="#34454D"/>
                      <TabControl Grid.Row="2">
                        <TabItem Header="基础属性">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VanillaFacts}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VanillaFactRow">
                                  <Border BorderBrush="#273942" BorderThickness="0,0,0,1"
                                          Padding="7,8">
                                    <Grid ColumnDefinitions="120,*,130" ColumnSpacing="6">
                                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                 TextWrapping="Wrap" Foreground="#A3B1B4"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                 TextWrapping="Wrap" FontFamily="Consolas"/>
                                      <TextBlock Grid.Column="2" Text="{Binding Origin}" FontSize="10"
                                                 Foreground="#8DBCB4" TextWrapping="Wrap"
                                                 ToolTip.Tip="{Binding XmlPath}"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </TabItem>
                        <TabItem Header="身体部件">
                          <Grid RowDefinitions="Auto,*" Margin="6" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="{Binding VanillaBodyName}"
                                       Foreground="#8DBCB4" FontSize="12"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding VanillaBodyParts}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VanillaBodyPartRow">
                                    <StackPanel Spacing="3" Margin="4,7">
                                      <TextBlock Text="{Binding Name}" FontFamily="Consolas"
                                                 FontSize="12" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Details}" FontSize="11"
                                                 Foreground="#A3B1B4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </Grid>
                        </TabItem>
                        <TabItem Header="装备与培育">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="7" Margin="8">
                              <TextBlock Text="PAWN KIND · 关联生成定义" Foreground="#CFB482" FontSize="11"/>
                              <ItemsControl ItemsSource="{Binding VanillaKinds}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VanillaRelatedRow">
                                    <StackPanel Spacing="2" Margin="0,4">
                                      <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Info}" FontSize="10" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Height="1" Background="#30414A"/>
                              <TextBlock Text="WEAPONS · 匹配武器标签的候选定义" Foreground="#CFB482" FontSize="11"/>
                              <ItemsControl ItemsSource="{Binding VanillaWeapons}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VanillaRelatedRow">
                                    <StackPanel Spacing="2" Margin="0,4">
                                      <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Info}" FontSize="10" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Height="1" Background="#30414A"/>
                              <TextBlock Text="RECIPE · 机械培育 / 制造配方" Foreground="#CFB482" FontSize="11"/>
                              <ItemsControl ItemsSource="{Binding VanillaRecipes}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VanillaRelatedRow">
                                    <StackPanel Spacing="2" Margin="0,4">
                                      <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Info}" FontSize="10" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>
                        <TabItem Header="源码 / 限制">
                          <Grid RowDefinitions="Auto,Auto,*" Margin="7" RowSpacing="7">
                            <TextBlock Grid.Row="0" Text="{Binding VanillaParentTemplate}"
                                       FontSize="11" Foreground="#8DBCB4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="{Binding VanillaNotes}"
                                       FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                            <TextBox Grid.Row="2" Text="{Binding VanillaOriginalXml}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                          </Grid>
                        </TabItem>
                      </TabControl>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="贴图预览">
              <Grid RowDefinitions="Auto,Auto,*" Margin="9" RowSpacing="9">
                <TextBlock Grid.Row="0" Text="GRAPHIC WORKBENCH · 使用本地 Mod PNG 只读预览，不复制原版素材"
                           FontSize="12" Foreground="#8DBCB4" Margin="0,6" TextWrapping="Wrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding Graphics}"
                            SelectedItem="{Binding SelectedGraphic,Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GraphicRow">
                        <TextBlock Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="{Binding GraphicInfo}" Foreground="#A3B1B4"
                             FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="215,*" ColumnSpacing="9">
                  <Border Grid.Column="0" BorderThickness="1" BorderBrush="#30434B" CornerRadius="5" Padding="5">
                    <ListBox ItemsSource="{Binding TextureCandidates}"
                             SelectedItem="{Binding SelectedTexture,Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TextureRow">
                          <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="5,8"/>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Column="1" Background="#0A1116" BorderBrush="#30434B"
                          BorderThickness="1" CornerRadius="5" Padding="16">
                    <Image Source="{Binding TexturePreview}" Stretch="Uniform"
                           MaxWidth="500" MaxHeight="460"/>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="部件与覆盖率">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
                <TextBlock Grid.Row="0" Text="BodyDef 装配树 · coverage 为相对权重，不代表实际命中率" Foreground="#A3B1B4" FontSize="12" Margin="0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding BodyParts}" SelectedItem="{Binding SelectedBodyPart,Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#33434B" BorderThickness="1" CornerRadius="5">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BodyRow">
                      <Border BorderBrush="#2C3C45" BorderThickness="0,0,0,1" Padding="7">
                        <Grid ColumnDefinitions="*,68,74,102" ColumnSpacing="4">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding EffectivePercent}" Height="4"
                                         Foreground="#8DBCB4" Background="#26363D"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Coverage}" Foreground="#8DBCB4" FontFamily="Consolas" FontSize="11"/>
                          <TextBlock Grid.Column="2" Text="{Binding Effective}" Foreground="#CFB482" FontFamily="Consolas" FontSize="11"/>
                          <TextBlock Grid.Column="3" Text="{Binding Layers}" FontSize="10" Foreground="#A3B1B4"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" BorderBrush="#35474F" BorderThickness="1" Background="#101920" CornerRadius="5" Padding="10">
                  <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                      <TextBlock Text="选中部件 / PART INSPECTOR" Foreground="#8DBCB4" FontWeight="SemiBold" FontSize="12"/>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="BodyPartDef 引用" Foreground="#A3B1B4" FontSize="11"/>
                          <TextBox Text="{Binding PartDefName,Mode=TwoWay}" PlaceholderText="MechanicalHead"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="相对覆盖率（核心为 1）" Foreground="#A3B1B4" FontSize="11"/>
                          <TextBox Text="{Binding PartCoverage,Mode=TwoWay}" PlaceholderText="0.10"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="高度 Height" Foreground="#A3B1B4" FontSize="11"/>
                          <ComboBox ItemsSource="{Binding Heights}" SelectedItem="{Binding PartHeight,Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="深度 Depth" Foreground="#A3B1B4" FontSize="11"/>
                          <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding PartDepth,Mode=TwoWay}"/>
                        </StackPanel>
                      </Grid>
                      <TextBox Text="{Binding PartCustomLabel,Mode=TwoWay}" PlaceholderText="可选显示名称（customLabel）"/>
                      <WrapPanel Orientation="Horizontal" ItemHeight="36" ItemWidth="105">
                        <Button Content="应用部件属性" Click="ApplyBody_Click" IsEnabled="{Binding HasBodyPart}"/>
                        <Button Content="上移" Click="MoveBodyUp_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                        <Button Content="下移" Click="MoveBodyDown_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                        <Button Content="删除子树" Click="RemoveBody_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                      </WrapPanel>
                      <Border Height="1" Background="#2C3C45" Margin="0,2"/>
                      <TextBlock Text="添加子部件 / APPEND CHILD" FontSize="11" Foreground="#CFB482"/>
                      <Grid ColumnDefinitions="*,104,108" ColumnSpacing="7">
                        <TextBox Grid.Column="0" Text="{Binding NewPartDefName,Mode=TwoWay}" PlaceholderText="部件 DefName"/>
                        <TextBox Grid.Column="1" Text="{Binding NewPartCoverage,Mode=TwoWay}" PlaceholderText="coverage"/>
                        <Button Grid.Column="2" Content="添加子部件" Click="AddBody_Click" IsEnabled="{Binding HasBodyPart}"/>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="XML 属性">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="9">
                <TextBlock Grid.Row="0" Text="高级原生 XML 属性 · ParentName / MayRequire / Class / Inherit 等，编辑时不丢弃未知属性"
                           FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding XmlAttributes}"
                         SelectedItem="{Binding SelectedXmlAttribute,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttributeRow">
                      <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" Margin="6,5"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="#111A20" BorderBrush="#35474F" BorderThickness="1"
                        CornerRadius="5" Padding="10">
                  <StackPanel Spacing="7">
                    <TextBlock Text="编辑选中的属性值" FontSize="11" Foreground="#CFB482"/>
                    <TextBox Text="{Binding XmlAttributeValue,Mode=TwoWay}" PlaceholderText="属性值"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="应用属性修改" Click="ApplyXmlAttribute_Click"/>
                      <Button Content="删除选中属性" Click="RemoveXmlAttribute_Click"/>
                    </StackPanel>
                    <Border Height="1" Background="#34454D" Margin="0,3"/>
                    <TextBlock Text="新增当前 Def 的属性（自定义子节点属性可在源码中编辑）"
                               Foreground="#A3B1B4" FontSize="11" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding NewXmlAttributeName,Mode=TwoWay}"
                               PlaceholderText="属性名"/>
                      <TextBox Grid.Column="1" Text="{Binding NewXmlAttributeValue,Mode=TwoWay}"
                               PlaceholderText="属性值"/>
                    </Grid>
                    <Button Content="添加原生属性" Click="AddXmlAttribute_Click"/>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="XML 预览">
              <TextBox Text="{Binding XmlPreview}" IsReadOnly="True" FontFamily="Consolas"
                       FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8"/>
            </TabItem>
            <TabItem Header="战斗分析">
              <Grid RowDefinitions="Auto,*" Margin="9" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="普通装备武器时序 · 仅计算明确配置的数值，未解析继承属性不推定 DPS" FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,7"/>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding WeaponProfiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WeaponProfileRow">
                        <Border Margin="0,3" BorderBrush="#35474F" BorderThickness="1" CornerRadius="5" Padding="11">
                          <StackPanel Spacing="9">
                            <TextBlock Text="{Binding WeaponName}" Foreground="#8DBCB4" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Verb}" Foreground="#CFB482" FontSize="11" FontFamily="Consolas"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding Projectile}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ShotCount}" FontSize="11"/>
                                <TextBlock Text="{Binding Range}" FontSize="11"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding Damage}" FontSize="11"/>
                                <TextBlock Text="{Binding Dps}" FontSize="11" TextWrapping="Wrap"/>
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Warmup}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding WarmupPercent}" Height="6" Foreground="#CFB482"/>
                            <TextBlock Text="{Binding Burst}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BurstPercent}" Height="6" Foreground="#8DBCB4"/>
                            <TextBlock Text="{Binding Cooldown}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding CooldownPercent}" Height="6" Foreground="#768D9A"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="基础属性">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="9" Margin="8">
                <TextBlock Grid.Row="0" Text="ThingDef / PawnKindDef 常用原生字段 · 建议值不会自动写出" Foreground="#A3B1B4" FontSize="12" TextWrapping="Wrap" Margin="0,7"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding MechProperties}"
                         SelectedItem="{Binding SelectedMechProperty,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MechPropertyRow">
                      <Grid ColumnDefinitions="180,*" Margin="8,5">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontSize="11" Foreground="#8DBCB4" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="#111A20" BorderBrush="#34454D" BorderThickness="1" Padding="10" CornerRadius="5">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding PropertyHint}" FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding PropertyValue,Mode=TwoWay}" PlaceholderText="输入自定义值"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="应用明确覆写" Click="ApplyMechProperty_Click"/>
                      <Button Content="恢复继承 / 未定义" Click="ResetMechProperty_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="引用关系">
              <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="本文件与本机已索引 Def 的引用关系。待解析不等于游戏加载错误。" FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReferenceRow">
                      <StackPanel Spacing="3" Margin="6">
                        <TextBlock Text="{Binding Display}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Location}" Foreground="#8DBCB4" FontSize="11"/>
                        <TextBlock Text="{Binding Path}" Foreground="#87969B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="跳转当前文件引用目标" Click="JumpReference_Click"/>
              </Grid>
            </TabItem>
            <TabItem Header="设计提示">
              <ScrollViewer Margin="15">
                <StackPanel Spacing="12">
                  <TextBlock Text="FIELD-DRIVEN EDITING" Foreground="#8DBCB4" FontWeight="Bold" FontSize="17"/>
                  <TextBlock Text="本工作台直接读取 Def XML。右侧字段检查器修改同一 XML 文档树，预览与部件覆盖率自动同步。" TextWrapping="Wrap"/>
                  <TextBlock Text="属性中的未知子节点与 XML 特性不会因修改其他叶子字段而主动删除。未修改的导入文档按原字节文本输出。" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                  <TextBlock Text="BodyDef 的 Inside / Outside、coverage 与父子依附关系来自原版伤害机制；可视化数字不等于实战直接命中率。" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                  <TextBlock Text="后续将接入完整元数据目录、类型驱动字段编辑、双向 XML 合并、贴图预览、武器时间轴和批量导出。" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <!-- Inspector and precise edit/save intention. -->
      <Border Grid.Column="2" Background="#151E24" CornerRadius="7" BorderBrush="#293C44" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,2*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="14">
          <TextBlock Grid.Row="0" Text="03   属性检查器 / INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="#8DBCB4" Margin="0,3,0,12"/>
          <TextBlock Grid.Row="1" Text="所有叶子字段 · 修改在点击应用后提交" FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Border Grid.Row="2" Background="#30424A" Height="1" Margin="0,0,0,5"/>
          <ListBox Grid.Row="3" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldRow">
                <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="3,6"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Spacing="3" Margin="0,9,0,8">
            <TextBlock Text="{Binding SelectedPath}" FontSize="11" FontFamily="Consolas" Foreground="#CFB482" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedFieldHint}" FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBox Grid.Row="5" Text="{Binding EditingValue,Mode=TwoWay}" AcceptsReturn="True" Height="68" TextWrapping="Wrap"/>
          <Button Grid.Row="6" Content="应用字段更改" Click="ApplyEdit_Click" Margin="0,8,0,12" Background="#32585C"/>
          <TextBlock Grid.Row="7" Text="新建定义 / INSERT DEF" FontSize="12" Foreground="#8DBCB4" FontWeight="Bold" Margin="0,0,0,8"/>
          <Grid Grid.Row="8" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="7">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" VerticalAlignment="Center" Foreground="#A3B1B4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SupportedKinds}" SelectedItem="{Binding NewDefType,Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="DefName" VerticalAlignment="Center" Foreground="#A3B1B4"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewDefName,Mode=TwoWay}"/>
            <Button Grid.Row="2" Grid.ColumnSpan="2" Content="插入基础定义" Click="AddDefinition_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="10,10,10,4" Background="#111A20" CornerRadius="7" BorderBrush="#293C44" BorderThickness="1">
      <Grid RowDefinitions="Auto,*" Margin="13">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="22" Margin="0,0,0,7">
          <TextBlock Text="04   诊断 / VALIDATION" Foreground="#8DBCB4" FontWeight="Bold" FontSize="12"/>
          <TextBlock Text="{Binding DiagnosticCount}" FontFamily="Consolas" Foreground="#CFB482" FontSize="11"/>
          <TextBlock Text="{Binding CatalogCount}" FontFamily="Consolas" Foreground="#A3B1B4" FontSize="11"/>
          <TextBlock Text="{Binding DefinitionCount}" FontFamily="Consolas" Foreground="#A3B1B4" FontSize="11"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Diagnostics}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DiagnosticRow">
              <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="4,3"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#0B1014" Padding="15,3" BorderBrush="#243741" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#A3B1B4"/>
        <TextBlock Grid.Column="1" Text="{Binding DirtyFlag}" FontSize="11" Foreground="#8DBCB4"/>
      </Grid>
    </Border>
  </Grid>
</Window>
