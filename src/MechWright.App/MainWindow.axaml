<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        x:Class="MechWright.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MechWright · 机械体设计工作台"
        Width="1360" Height="850" MinWidth="1050" MinHeight="680"
        Icon="avares://MechWright.App/Assets/brand-chip.png"
        Background="#0C1116" Foreground="#E9ECEC">
  <Grid RowDefinitions="74,*,39">
    <!-- Only entry actions are global. Specialist controls live in their stage. -->
    <Border Grid.Row="0" Background="#121B21" BorderBrush="#293D46" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Image Source="avares://MechWright.App/Assets/brand-chip.png" Width="28" Height="28"/>
          <StackPanel Spacing="2">
            <TextBlock Text="MECHWRIGHT" FontSize="17" FontWeight="Bold" LetterSpacing="1.5"/>
            <TextBlock Text="RIMWORLD 1.7   /   DESIGN STUDIO" FontSize="10" Foreground="#8CB9B2"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Button Content="新建机械体" Classes="primary" Click="NewMechanoidWizard_Click"/>
          <Button Content="导入 Mod" Click="ImportWorkspace_Click"/>
          <Button Content="原版图鉴" Click="OpenVanillaLibrary_Click"/>
          <Border Width="1" Background="#354750" Margin="4,5"/>
          <Button Content="撤销" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
          <Button Content="重做" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Intentional first-run experience: no empty editors before a document exists. -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowStartPage}" Margin="36,26">
      <Grid RowDefinitions="*,Auto,*" MaxWidth="880" HorizontalAlignment="Center">
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Spacing="12" Margin="0,0,0,34">
          <TextBlock Text="机 械 体 设 计 工 作 台" FontSize="30" FontWeight="Bold" Foreground="#EDF1F1"/>
          <TextBlock Text="从一个机械体开始。按照基础属性、身体、武器与资源的顺序完成配置，最后检查并导出。"
                     FontSize="14" Foreground="#A4B6BD" TextWrapping="Wrap" MaxWidth="700"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18" MinHeight="230">
          <Border Grid.Column="0" Classes="feature-card" Padding="24">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
              <TextBlock Grid.Row="0" Text="01 / CREATE" FontFamily="Consolas" Foreground="#8CBEB4" FontSize="11"/>
              <TextBlock Grid.Row="1" Text="新建机械体" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="2" Text="填写机体的名称与常规数据，自动建立关联 XML。随后按步骤继续设计。"
                         FontSize="13" Foreground="#9EAFB6" TextWrapping="Wrap"/>
              <Button Grid.Row="3" Content="开始设计" Classes="primary" HorizontalAlignment="Stretch"
                      Click="NewMechanoidWizard_Click"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="feature-card" Padding="24">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
              <TextBlock Grid.Row="0" Text="02 / CONTINUE" FontFamily="Consolas" Foreground="#8CBEB4" FontSize="11"/>
              <TextBlock Grid.Row="1" Text="继续已有 Mod" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="2" Text="读取现有 Mod 的 XML，保留未知字段与结构，在可视化编辑器中继续修改。"
                         FontSize="13" Foreground="#9EAFB6" TextWrapping="Wrap"/>
              <Button Grid.Row="3" Content="选择 Mod 文件夹" HorizontalAlignment="Stretch"
                      Click="ImportWorkspace_Click"/>
            </Grid>
          </Border>
        </Grid>
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Spacing="13" Margin="0,26,0,0">
          <Border Background="#121E24" BorderBrush="#2C4249" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="原版机械体资料" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="连接本机 RimWorld 的 Core / DLC 目录，查看原版机体配置、身体和装备。"
                           FontSize="11" Foreground="#9EAFB6" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="选择游戏目录" VerticalAlignment="Center"
                      Click="ScanCatalog_Click"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Button Content="新建空白 XML" Click="NewFile_Click"/>
            <Button Content="打开单个 XML" Click="OpenFile_Click"/>
            <Button Content="新建空白工程" Click="NewWorkspace_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Focused workspace: current step owns the screen, not 11 simultaneous tabs. -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowWorkspacePage}"
          ColumnDefinitions="245,*" ColumnSpacing="14" Margin="16,14">
      <Border Grid.Column="0" Background="#121B21" BorderBrush="#294048"
              BorderThickness="1" CornerRadius="9">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,105,Auto,Auto,*" Margin="14" RowSpacing="9">
          <StackPanel Grid.Row="0" Spacing="4" Margin="3,6,0,5">
            <TextBlock Text="设计流程" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding WorkspaceTitle}" Foreground="#91A7B1" FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ListBox Grid.Row="1" SelectedIndex="{Binding WorkflowStep,Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBoxItem Content="01  基础配置"/>
            <ListBoxItem Content="02  身体与外观"/>
            <ListBoxItem Content="03  武器与战斗"/>
            <ListBoxItem Content="04  工程资源"/>
            <ListBoxItem Content="05  检查并导出"/>
            <ListBoxItem Content="高级 XML 工具"/>
          </ListBox>
          <Border Grid.Row="2" Height="1" Background="#304149" Margin="0,5"/>
          <TextBlock Grid.Row="3" Text="工程文件" FontSize="12" Foreground="#8CBEB4"/>
          <ListBox Grid.Row="4" ItemsSource="{Binding ProjectFiles}"
                   SelectedItem="{Binding SelectedProjectFile,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectFileRow">
                <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis" Margin="4,5"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="5" Text="当前文件中的定义" FontSize="12" Foreground="#8CBEB4"/>
          <TextBox Grid.Row="6" Text="{Binding SearchQuery,Mode=TwoWay}"
                   PlaceholderText="搜索 DefName"/>
          <ListBox Grid.Row="7" ItemsSource="{Binding VisibleDefinitions}"
                   SelectedItem="{Binding SelectedDefinition,Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DefinitionRow">
                <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="4,6"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#141D23" BorderBrush="#294048"
              BorderThickness="1" CornerRadius="9">
        <Grid RowDefinitions="90,*,64" Margin="20" RowSpacing="12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="15">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding WorkflowTitle}" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding WorkflowDescription}" FontSize="12" Foreground="#93A9B0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" HorizontalAlignment="Right">
              <TextBlock Text="{Binding SelectedDefName}" FontFamily="Consolas" FontSize="12"
                         Foreground="#C7E0D8" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding SourceName}" FontSize="10" Foreground="#77929A"
                         TextTrimming="CharacterEllipsis" MaxWidth="290"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="#101820" BorderBrush="#293B44" BorderThickness="1"
                  CornerRadius="7" Padding="9">
            <Grid>
              <Grid IsVisible="{Binding IsBasicStage}" ColumnDefinitions="*,300" ColumnSpacing="12">
                <TabControl Grid.Column="0">
                  <TabItem Header="基础属性">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="9" Margin="8">
                <TextBlock Grid.Row="0" Text="ThingDef / PawnKindDef 常用原生字段 · 建议值不会自动写出" Foreground="#A3B1B4" FontSize="12" TextWrapping="Wrap" Margin="0,7"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding MechProperties}"
                         SelectedItem="{Binding SelectedMechProperty,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MechPropertyRow">
                      <Grid ColumnDefinitions="180,*" Margin="8,5">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontSize="11" Foreground="#8DBCB4" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="#111A20" BorderBrush="#34454D" BorderThickness="1" Padding="10" CornerRadius="5">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding PropertyHint}" FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding PropertyValue,Mode=TwoWay}" PlaceholderText="输入自定义值"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="应用明确覆写" Click="ApplyMechProperty_Click"/>
                      <Button Content="恢复继承 / 未定义" Click="ResetMechProperty_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
                </TabControl>
                <Border Grid.Column="1" Background="#101920" BorderBrush="#2D4049" BorderThickness="1" CornerRadius="9" Padding="15">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10">
    <StackPanel Grid.Row="0" Spacing="5">
      <TextBlock Text="精确字段编辑" FontWeight="SemiBold" FontSize="14"/>
      <TextBlock Text="选择字段并修改。只有点击应用后才写入 XML。" FontSize="11" Foreground="#91A7B1" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Height="1" Background="#31434B"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField,Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FieldRow">
          <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="5,7"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Spacing="5">
      <TextBlock Text="{Binding SelectedPath}" FontSize="11" FontFamily="Consolas" Foreground="#E0C58A" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding SelectedFieldHint}" FontSize="11" Foreground="#91A7B1" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBox Grid.Row="4" Text="{Binding EditingValue,Mode=TwoWay}" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/>
    <Button Grid.Row="5" Classes="primary" Content="应用字段更改" Click="ApplyEdit_Click"/>
  </Grid>
</Border>
              </Grid>
              <TabControl IsVisible="{Binding IsBodyStage}">
                <TabItem Header="部件与覆盖率">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
                <TextBlock Grid.Row="0" Text="BodyDef 装配树 · coverage 为相对权重，不代表实际命中率" Foreground="#A3B1B4" FontSize="12" Margin="0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding BodyParts}" SelectedItem="{Binding SelectedBodyPart,Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#33434B" BorderThickness="1" CornerRadius="5">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BodyRow">
                      <Border BorderBrush="#2C3C45" BorderThickness="0,0,0,1" Padding="7">
                        <Grid ColumnDefinitions="*,68,74,102" ColumnSpacing="4">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding EffectivePercent}" Height="4"
                                         Foreground="#8DBCB4" Background="#26363D"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Coverage}" Foreground="#8DBCB4" FontFamily="Consolas" FontSize="11"/>
                          <TextBlock Grid.Column="2" Text="{Binding Effective}" Foreground="#CFB482" FontFamily="Consolas" FontSize="11"/>
                          <TextBlock Grid.Column="3" Text="{Binding Layers}" FontSize="10" Foreground="#A3B1B4"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" BorderBrush="#35474F" BorderThickness="1" Background="#101920" CornerRadius="5" Padding="10">
                  <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                      <TextBlock Text="选中部件 / PART INSPECTOR" Foreground="#8DBCB4" FontWeight="SemiBold" FontSize="12"/>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="BodyPartDef 引用" Foreground="#A3B1B4" FontSize="11"/>
                          <TextBox Text="{Binding PartDefName,Mode=TwoWay}" PlaceholderText="MechanicalHead"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="相对覆盖率（核心为 1）" Foreground="#A3B1B4" FontSize="11"/>
                          <TextBox Text="{Binding PartCoverage,Mode=TwoWay}" PlaceholderText="0.10"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="高度 Height" Foreground="#A3B1B4" FontSize="11"/>
                          <ComboBox ItemsSource="{Binding Heights}" SelectedItem="{Binding PartHeight,Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="深度 Depth" Foreground="#A3B1B4" FontSize="11"/>
                          <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding PartDepth,Mode=TwoWay}"/>
                        </StackPanel>
                      </Grid>
                      <TextBox Text="{Binding PartCustomLabel,Mode=TwoWay}" PlaceholderText="可选显示名称（customLabel）"/>
                      <WrapPanel Orientation="Horizontal" ItemHeight="36" ItemWidth="105">
                        <Button Content="应用部件属性" Click="ApplyBody_Click" IsEnabled="{Binding HasBodyPart}"/>
                        <Button Content="上移" Click="MoveBodyUp_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                        <Button Content="下移" Click="MoveBodyDown_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                        <Button Content="删除子树" Click="RemoveBody_Click" IsEnabled="{Binding CanRemoveBodyPart}"/>
                      </WrapPanel>
                      <Border Height="1" Background="#2C3C45" Margin="0,2"/>
                      <TextBlock Text="添加子部件 / APPEND CHILD" FontSize="11" Foreground="#CFB482"/>
                      <Grid ColumnDefinitions="*,104,108" ColumnSpacing="7">
                        <TextBox Grid.Column="0" Text="{Binding NewPartDefName,Mode=TwoWay}" PlaceholderText="部件 DefName"/>
                        <TextBox Grid.Column="1" Text="{Binding NewPartCoverage,Mode=TwoWay}" PlaceholderText="coverage"/>
                        <Button Grid.Column="2" Content="添加子部件" Click="AddBody_Click" IsEnabled="{Binding HasBodyPart}"/>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>
<TabItem Header="贴图预览">
              <Grid RowDefinitions="Auto,Auto,*" Margin="9" RowSpacing="9">
                <TextBlock Grid.Row="0" Text="GRAPHIC WORKBENCH · 使用本地 Mod PNG 只读预览，不复制原版素材"
                           FontSize="12" Foreground="#8DBCB4" Margin="0,6" TextWrapping="Wrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding Graphics}"
                            SelectedItem="{Binding SelectedGraphic,Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GraphicRow">
                        <TextBlock Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="{Binding GraphicInfo}" Foreground="#A3B1B4"
                             FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="215,*" ColumnSpacing="9">
                  <Border Grid.Column="0" BorderThickness="1" BorderBrush="#30434B" CornerRadius="5" Padding="5">
                    <ListBox ItemsSource="{Binding TextureCandidates}"
                             SelectedItem="{Binding SelectedTexture,Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TextureRow">
                          <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="5,8"/>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Column="1" Background="#0A1116" BorderBrush="#30434B"
                          BorderThickness="1" CornerRadius="5" Padding="16">
                    <Grid>
                      <Image Source="{Binding TexturePreview}" Stretch="Uniform"
                             MaxWidth="500" MaxHeight="460"/>
                      <StackPanel IsVisible="{Binding ShowTexturePlaceholder}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Spacing="12" MaxWidth="310">
                        <TextBlock Text="尚未找到可预览的贴图" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#C1D6D2" TextAlignment="Center"/>
                        <TextBlock Text="在“工程资源”中登记本地 PNG，并为机械体定义 texPath。完成后预览会自动关联资源。"
                                   Foreground="#94AAB1" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="12"/>
                        <Button Content="前往工程资源" Click="GoToAssets_Click"
                                HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>
              </TabControl>
              <TabControl x:Name="CombatTabs" IsVisible="{Binding IsWeaponStage}">
                <TabItem Header="战斗分析">
              <Grid RowDefinitions="Auto,*" Margin="9" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="普通装备武器时序 · 仅计算明确配置的数值，未解析继承属性不推定 DPS" FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,7"/>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding WeaponProfiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WeaponProfileRow">
                        <Border Margin="0,3" BorderBrush="#35474F" BorderThickness="1" CornerRadius="5" Padding="11">
                          <StackPanel Spacing="9">
                            <TextBlock Text="{Binding WeaponName}" Foreground="#8DBCB4" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Verb}" Foreground="#CFB482" FontSize="11" FontFamily="Consolas"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding Projectile}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ShotCount}" FontSize="11"/>
                                <TextBlock Text="{Binding Range}" FontSize="11"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding Damage}" FontSize="11"/>
                                <TextBlock Text="{Binding Dps}" FontSize="11" TextWrapping="Wrap"/>
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Warmup}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding WarmupPercent}" Height="6" Foreground="#CFB482"/>
                            <TextBlock Text="{Binding Burst}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BurstPercent}" Height="6" Foreground="#8DBCB4"/>
                            <TextBlock Text="{Binding Cooldown}" Foreground="#A3B1B4" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding CooldownPercent}" Height="6" Foreground="#768D9A"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" IsVisible="{Binding ShowCombatEmpty}"
                        Background="#111D24" BorderBrush="#2D444C" BorderThickness="1"
                        Padding="20" CornerRadius="7">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                              Spacing="12" MaxWidth="390">
                    <TextBlock Text="当前机体还没有可解析的武器配置" FontSize="16"
                               FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="在“原生列表结构”中添加武器攻击所需的 verbs / tools。完成后可查看连发时间、伤害与理论 DPS。"
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#94AAB1"/>
                    <Button Content="编辑武器列表" Classes="primary"
                            Click="OpenCombatLists_Click" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
<TabItem Header="原生列表结构">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9" Margin="8">
                <TextBlock Grid.Row="0" Text="NATIVE LIST STRUCTURES · 工具 / 武器 / Comp / 标签"
                           Foreground="#8DBCB4" FontSize="12" Margin="0,4"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding NativeListGroups}"
                          SelectedItem="{Binding SelectedListGroup,Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NativeListGroupRow">
                      <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Row="2" ColumnDefinitions="*" RowDefinitions="*">
                  <ListBox ItemsSource="{Binding NativeListEntries}"
                           SelectedItem="{Binding SelectedListEntry,Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NativeListItemRow">
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Margin="4,6"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <Border Grid.Row="3" Background="#101920" BorderBrush="#34454D"
                        BorderThickness="1" Padding="10" CornerRadius="5">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding ListHelp}" Foreground="#A3B1B4" FontSize="11"
                               TextWrapping="Wrap"/>
                    <TextBox Text="{Binding ListXml,Mode=TwoWay}" AcceptsReturn="True"
                             AcceptsTab="True" TextWrapping="NoWrap" Height="127"
                             FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <WrapPanel Orientation="Horizontal" ItemHeight="34" ItemWidth="93">
                      <Button Content="新增项" Click="AddNativeList_Click"
                              IsEnabled="{Binding HasListGroup}"/>
                      <Button Content="应用修改" Click="ReplaceNativeList_Click"
                              IsEnabled="{Binding HasSelectedListEntry}"/>
                      <Button Content="复制项" Click="DuplicateNativeList_Click"
                              IsEnabled="{Binding HasSelectedListEntry}"/>
                      <Button Content="上移" Click="MoveNativeListUp_Click"
                              IsEnabled="{Binding HasSelectedListEntry}"/>
                      <Button Content="下移" Click="MoveNativeListDown_Click"
                              IsEnabled="{Binding HasSelectedListEntry}"/>
                      <Button Content="删除项" Click="RemoveNativeList_Click"
                              IsEnabled="{Binding HasSelectedListEntry}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
              </TabControl>
              <TabControl IsVisible="{Binding IsAssetStage}">
                <TabItem Header="工程资源">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9" Margin="8">
                <TextBlock Grid.Row="0" Text="{Binding AssetSummary}" Foreground="#8DBCB4"
                           FontSize="12" Margin="0,5"/>
                <TextBlock Grid.Row="1" Text="只登记本 Mod 的贴图、音频和程序集；不会提取或复制原版 DLC 资源。"
                           FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding ProjectAssets}"
                         SelectedItem="{Binding SelectedProjectAsset,Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectAssetRow">
                      <StackPanel Spacing="4" Margin="4,6">
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Size}" FontSize="10"
                                   Foreground="#8DBCB4"/>
                        <TextBlock Text="{Binding Source}" FontSize="10"
                                   Foreground="#A3B1B4" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" Background="#101920" BorderBrush="#34454D"
                        BorderThickness="1" CornerRadius="5" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding AssetMessage}" FontSize="11"
                               Foreground="#A3B1B4" TextWrapping="Wrap"/>
                    <Button Content="选择本机资源" Click="ChooseProjectAsset_Click"
                            IsEnabled="{Binding HasWorkspace}"/>
                    <TextBlock Text="{Binding AssetInputFile}" FontSize="10"
                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                    <TextBox Text="{Binding AssetOutputPath,Mode=TwoWay}"
                             PlaceholderText="Textures/Things/Mechanoids/Unit_south.png"/>
                    <WrapPanel Orientation="Horizontal" ItemWidth="150" ItemHeight="35">
                      <Button Content="登记项目资源" Click="RegisterProjectAsset_Click"
                              IsEnabled="{Binding HasWorkspace}"/>
                      <Button Content="从清单移除" Click="RemoveProjectAsset_Click"
                              IsEnabled="{Binding HasProjectAsset}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
              </TabControl>
              <TabControl IsVisible="{Binding IsReviewStage}">
                <TabItem Header="诊断检查">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="检查当前工程 XML 结构与本地可解析引用" FontSize="14" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
      <TextBlock Text="{Binding DiagnosticCount}" Foreground="#E0C58A"/>
      <TextBlock Text="{Binding DefinitionCount}" Foreground="#8DBCB4"/>
      <TextBlock Text="{Binding CatalogCount}" Foreground="#91A7B1"/>
    </StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Diagnostics}" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DiagnosticRow">
          <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="6,7"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</TabItem>
                <TabItem Header="引用关系">
              <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="本文件与本机已索引 Def 的引用关系。待解析不等于游戏加载错误。" FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReferenceRow">
                      <StackPanel Spacing="3" Margin="6">
                        <TextBlock Text="{Binding Display}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Location}" Foreground="#8DBCB4" FontSize="11"/>
                        <TextBlock Text="{Binding Path}" Foreground="#87969B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="跳转当前文件引用目标" Click="JumpReference_Click"/>
              </Grid>
            </TabItem>
<TabItem Header="XML 预览">
              <TextBox Text="{Binding XmlPreview}" IsReadOnly="True" FontFamily="Consolas"
                       FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8"/>
            </TabItem>
              </TabControl>
              <Grid IsVisible="{Binding IsAdvancedStage}" RowDefinitions="Auto,*" RowSpacing="10">
                <Border Grid.Row="0" Background="#15272C" CornerRadius="5" Padding="12">
                  <WrapPanel Orientation="Horizontal" ItemHeight="34">
                    <TextBox Width="200" Text="{Binding NewProjectXmlPath,Mode=TwoWay}"
                             PlaceholderText="1.7/Defs/NewDefs.xml"/>
                    <Button Content="添加工程 XML" Click="AddProjectXml_Click"
                            IsEnabled="{Binding HasWorkspace}"/>
                    <ComboBox Width="120" ItemsSource="{Binding SupportedKinds}"
                              SelectedItem="{Binding NewDefType,Mode=TwoWay}"/>
                    <TextBox Width="155" Text="{Binding NewDefName,Mode=TwoWay}"/>
                    <Button Content="新增定义" Click="AddDefinition_Click"/>
                    <Button Content="编辑源码" Click="EditRaw_Click"/>
                    <Button Content="导出当前 XML" Click="Export_Click"/>
                  </WrapPanel>
                </Border>
                <TabControl Grid.Row="1">
                  <TabItem Header="原版字段库">
              <Grid Margin="9" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="{Binding NativeFieldStatus}" FontSize="11"
                           Foreground="#A3B1B4" TextWrapping="Wrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="9">
                  <TextBox Grid.Column="0" Text="{Binding NativeFieldSearch,Mode=TwoWay}"
                           PlaceholderText="搜索已安装原版 XML 字段路径或示例"/>
                  <CheckBox Grid.Column="1" Content="只看可插入字段"
                            IsChecked="{Binding NativeOnlySimple,Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleNativeFields}"
                         SelectedItem="{Binding SelectedNativeField,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NativeFieldRow">
                      <StackPanel Margin="5,6" Spacing="3">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas"
                                   FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Meta}" Foreground="#8DBCB4"
                                   FontSize="10" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" Background="#101920" BorderBrush="#35474F"
                        BorderThickness="1" CornerRadius="5" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding NativeFieldTip}" FontSize="11"
                               Foreground="#A3B1B4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding NativeFieldValue,Mode=TwoWay}"
                             PlaceholderText="明确输入写入值，示例可修改"/>
                    <Button Content="将字段写入当前编辑的 Def" Click="ApplyNativeField_Click"
                            IsEnabled="{Binding CanInsertNativeField}" Background="#31565C"/>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
<TabItem Header="XML 属性">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="9">
                <TextBlock Grid.Row="0" Text="高级原生 XML 属性 · ParentName / MayRequire / Class / Inherit 等，编辑时不丢弃未知属性"
                           FontSize="11" Foreground="#A3B1B4" TextWrapping="Wrap" Margin="0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding XmlAttributes}"
                         SelectedItem="{Binding SelectedXmlAttribute,Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttributeRow">
                      <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" Margin="6,5"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="#111A20" BorderBrush="#35474F" BorderThickness="1"
                        CornerRadius="5" Padding="10">
                  <StackPanel Spacing="7">
                    <TextBlock Text="编辑选中的属性值" FontSize="11" Foreground="#CFB482"/>
                    <TextBox Text="{Binding XmlAttributeValue,Mode=TwoWay}" PlaceholderText="属性值"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="应用属性修改" Click="ApplyXmlAttribute_Click"/>
                      <Button Content="删除选中属性" Click="RemoveXmlAttribute_Click"/>
                    </StackPanel>
                    <Border Height="1" Background="#34454D" Margin="0,3"/>
                    <TextBlock Text="新增当前 Def 的属性（自定义子节点属性可在源码中编辑）"
                               Foreground="#A3B1B4" FontSize="11" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding NewXmlAttributeName,Mode=TwoWay}"
                               PlaceholderText="属性名"/>
                      <TextBox Grid.Column="1" Text="{Binding NewXmlAttributeValue,Mode=TwoWay}"
                               PlaceholderText="属性值"/>
                    </Grid>
                    <Button Content="添加原生属性" Click="AddXmlAttribute_Click"/>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
                </TabControl>
              </Grid>
              <Border IsVisible="{Binding NeedsFirstMechanoid}"
                      Background="#101A21" BorderBrush="#314B51" BorderThickness="1"
                      CornerRadius="8" Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" MaxWidth="430">
                  <TextBlock Text="工程已创建，接下来装配机械体"
                             FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock Text="填写名称、战斗点数和基础属性，系统会同时建立 ThingDef、PawnKindDef 与 BodyDef。随后可以继续编辑身体结构、武器和贴图。"
                             Foreground="#93A9B0" FontSize="13" TextWrapping="Wrap"
                             TextAlignment="Center"/>
                  <Button Content="装配第一台机械体" Classes="primary"
                          Click="NewMechanoidWizard_Click" HorizontalAlignment="Center"/>
                  <Button Content="高级：手动建立 XML 定义" Click="OpenAdvanced_Click"
                          HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding DiagnosticCount}" FontSize="11" Foreground="#D4B785"/>
              <TextBlock Text="·" Foreground="#51666E"/>
              <TextBlock Text="{Binding DirtyFlag}" FontSize="11" Foreground="#91A7B1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="上一步" Click="PreviousStage_Click" IsEnabled="{Binding CanGoBackStage}"/>
              <Button Content="下一步" Click="NextStage_Click"
                      Classes="primary" IsVisible="{Binding CanGoForwardStage}"/>
              <Button Content="导出 Mod" Classes="primary" Click="ExportWorkspace_Click"
                      IsVisible="{Binding IsReviewStage}" IsEnabled="{Binding CanExportProject}"/>
              <Button Content="返回检查" Click="ReturnToReview_Click"
                      IsVisible="{Binding IsAdvancedStage}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0D151A" BorderBrush="#293D46"
            BorderThickness="0,1,0,0" Padding="18,7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="#A1B1B6"
                   FontSize="11" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="LOCAL XML  /  RIMWORLD 1.7"
                   Foreground="#648681" FontFamily="Consolas" FontSize="10"/>
      </Grid>
    </Border>
  </Grid>
</Window>