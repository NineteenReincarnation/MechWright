<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MechWright.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#161C22"/>
      <Setter Property="Foreground" Value="#F0F2F2"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#2D3741"/>
      <Setter Property="Foreground" Value="#F0F2F2"/>
      <Setter Property="BorderBrush" Value="#45525D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.10"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#394650"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1C252D"/>
      <Setter Property="BorderBrush" Value="#465762"/>
      <Setter Property="Foreground" Value="#F0F2F2"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Lilt-inspired feedback adapted to native Avalonia input states. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#38675E"/>
      <Setter Property="BorderBrush" Value="#568C80"/>
      <Setter Property="Foreground" Value="#F6FBF9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#47796E"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.82"/>
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#9AD2C6"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.preset-card">
      <Setter Property="Background" Value="#1A2B31"/>
      <Setter Property="BorderBrush" Value="#35515A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.preset-card">
      <Setter Property="Background" Value="#294C4D"/>
      <Setter Property="BorderBrush" Value="#6FB7A9"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.feature-card">
      <Setter Property="Background" Value="#16232A"/>
      <Setter Property="BorderBrush" Value="#30484C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#293842"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#304348"/>
      <Setter Property="Foreground" Value="#F0F2F2"/>
      <Setter Property="BorderBrush" Value="#4B796F"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TabControl.workbench TabItem">
      <Setter Property="Padding" Value="15,11"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#A9BAC0"/>
    </Style>
    <Style Selector="TabControl.workbench TabItem:selected">
      <Setter Property="Background" Value="#30443F"/>
      <Setter Property="Foreground" Value="#EFF6F3"/>
    </Style>
  </Application.Styles>
</Application>
