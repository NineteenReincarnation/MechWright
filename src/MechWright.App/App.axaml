<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MechWright.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0B1014"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#25363C"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
      <Setter Property="BorderBrush" Value="#40555A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#345258"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#111A20"/>
      <Setter Property="BorderBrush" Value="#3E5158"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Application.Styles>
</Application>
