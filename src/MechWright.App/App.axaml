<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MechWright.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0B1014"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#25363C"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
      <Setter Property="BorderBrush" Value="#40555A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#345258"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#111A20"/>
      <Setter Property="BorderBrush" Value="#3E5158"/>
      <Setter Property="Foreground" Value="#E6ECEB"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Lilt-inspired feedback adapted to native Avalonia input states. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#315A57"/>
      <Setter Property="BorderBrush" Value="#477F79"/>
      <Setter Property="Foreground" Value="#F0F9F7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#40736C"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.82"/>
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#9AD2C6"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.feature-card">
      <Setter Property="Background" Value="#16232A"/>
      <Setter Property="BorderBrush" Value="#30484C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#20343B"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#294E51"/>
      <Setter Property="Foreground" Value="#E9F6F3"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
  </Application.Styles>
</Application>
