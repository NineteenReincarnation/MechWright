<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        x:Class="MechWright.App.MechanoidWizardWindow"
        x:DataType="vm:MechanoidWizardViewModel"
        Title="MechWright · 新建机械体"
        Width="775" Height="785" MinWidth="660" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="#0B1014" Foreground="#E6ECEB">
  <Grid RowDefinitions="Auto,*,Auto" Margin="19" RowSpacing="14">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="新建机械体" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="从第一项到最后一项依次填写。没有预设限制，所有数据均由你决定。"
                 Foreground="#A5BBBB" FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Text="创建后还可以继续增减身体部件、武器、组件和其他原生配置。"
                 Foreground="#819FA3" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <Border Background="#17262C" CornerRadius="7" Padding="12">
          <TextBlock Text="01 · 身份与基础属性" FontSize="15"
                     FontWeight="SemiBold" Foreground="#B2D9CB"/>
        </Border>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="机械体名称" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding Label,Mode=TwoWay}"
                        Watermark="请输入机械体的显示名称" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="机体标识" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding DefName,Mode=TwoWay}"
                        Watermark="例如 MP_NewMechanoid" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="重量等级" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding WeightClasses}"
                          SelectedItem="{Binding WeightClass,Mode=TwoWay}" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="战斗点数（CP）" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding CP,Mode=TwoWay}"
                        Watermark="0 及以上" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="身体大小" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding BodySize,Mode=TwoWay}"
                        Watermark="例如 1.6" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="生命倍率" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding HealthScale,Mode=TwoWay}"
                        Watermark="例如 1.35" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="移动速度（格/秒）" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding MoveSpeed,Mode=TwoWay}"
                        Watermark="例如 3.9" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="机体质量（kg）" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding Mass,Mode=TwoWay}"
                        Watermark="例如 120" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="锐器护甲" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding SharpArmor,Mode=TwoWay}"
                        Watermark="例如 0.55" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="钝器护甲" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding BluntArmor,Mode=TwoWay}"
                        Watermark="例如 0.35" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="热能护甲" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding HeatArmor,Mode=TwoWay}"
                        Watermark="例如 2.0" MinHeight="38"/>
            </Grid>
            <Grid ColumnDefinitions="220,*" ColumnSpacing="16" MinHeight="43">
              <TextBlock Grid.Column="0" Text="机械控制带宽" FontSize="13"
                         Foreground="#D2DDDA" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding BandwidthCost,Mode=TwoWay}"
                        Watermark="非负整数" MinHeight="38"/>
            </Grid>
        <Border Background="#132B2C" CornerRadius="8" Padding="14"
                Margin="0,12,0,0">
          <StackPanel Spacing="10">
            <TextBlock Text="创建前确认" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#C6DFD8"
                       TextWrapping="Wrap"/>
            <Button Content="查看当前填写的数据" Click="Preview_Click"
                    HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Grid.Column="0" Text="{Binding Error}" Foreground="#D87C76"
                 TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Content="取消" Click="Cancel_Click"/>
        <Button Content="创建并继续配置" Click="Confirm_Click"
                Classes="primary" Background="#31575A"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>