<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MechWright.App.ViewModels"
        x:Class="MechWright.App.MechanoidWizardWindow"
        x:DataType="vm:MechanoidWizardViewModel"
        Title="MECHWRIGHT · 新机械体装配向导"
        Width="960" Height="820" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1014" Foreground="#E6ECEB">
  <Grid RowDefinitions="Auto,*,150,Auto" Margin="19" RowSpacing="13">
    <StackPanel Grid.Row="0" Spacing="5">
      <TextBlock Text="设计第一台机械体" FontSize="23"
                 FontWeight="Bold" Foreground="#8DBCB4"/>
      <TextBlock Text="先选一个定位，再修改数值。完成后进入图形化工作台继续设计身体、武器和贴图。"
                 FontSize="12" Foreground="#A3B1B4" TextWrapping="Wrap"/>
      <ListBox ItemsSource="{Binding WizardPresetCards}"
               SelectedItem="{Binding SelectedWizardPreset,Mode=TwoWay}" Height="110">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="214" ItemHeight="102"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VisualChassisRow">
            <Border Classes="preset-card" Margin="4" Padding="10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="{Binding Icon}" FontSize="24" Foreground="#A5D4CC"/>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Score}" Foreground="#85B9B1" FontSize="10"/>
                <TextBlock Text="{Binding Detail}" Foreground="#9CACB3" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <StackPanel Grid.Column="0" Spacing="9">
          <TextBlock Text="名称与定位" Foreground="#8DBCB4" FontSize="12"/>
          <TextBlock Text="机械体标识（自动生成）" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding DefName}" IsReadOnly="True" FontFamily="Consolas"/>
          <TextBlock Text="机械体名称" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding Label,Mode=TwoWay}"/>
          <TextBlock Text="机体重量类别" FontSize="11" Foreground="#A3B1B4"/>
          <ComboBox ItemsSource="{Binding WeightClasses}"
                    SelectedItem="{Binding WeightClass,Mode=TwoWay}"/>
          <TextBlock Text="战斗强度（CP）" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding CP,Mode=TwoWay}"/>
          <TextBlock Text="身体大小" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding BodySize,Mode=TwoWay}"/>
          <TextBlock Text="身体耐久倍率" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding HealthScale,Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="9">
          <TextBlock Text="性能与防护" Foreground="#8DBCB4" FontSize="12"/>
          <TextBlock Text="移动速度（格/秒）" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding MoveSpeed,Mode=TwoWay}"/>
          <TextBlock Text="机体质量（kg）" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding Mass,Mode=TwoWay}"/>
          <TextBlock Text="锐器护甲" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding SharpArmor,Mode=TwoWay}"/>
          <TextBlock Text="钝器护甲" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding BluntArmor,Mode=TwoWay}"/>
          <TextBlock Text="热能护甲" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding HeatArmor,Mode=TwoWay}"/>
          <TextBlock Text="机械控制带宽" FontSize="11" Foreground="#A3B1B4"/>
          <TextBox Text="{Binding BandwidthCost,Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#111A20" BorderBrush="#33454C"
            BorderThickness="1" CornerRadius="6" Padding="10">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="设计摘要 / 创建前确认"
                   FontSize="12" FontWeight="Bold" Foreground="#8DBCB4"/>
        <TextBlock Grid.Row="1" Text="{Binding Preview}" TextWrapping="Wrap"
                   FontSize="12" Foreground="#C8DEDA" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Text="{Binding Error}" Foreground="#D87C76"
                 TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Content="预览设计" Click="Preview_Click"/>
        <Button Content="取消" Click="Cancel_Click"/>
        <Button Content="创建机械体并进入设计" Click="Confirm_Click" Background="#31575A"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
