<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MechWright.App.Views"
        x:Class="MechWright.App.VanillaLibraryWindow"
        Title="MECHWRIGHT · 原版机械体图鉴 / CORE + DLC"
        Width="1280" Height="830" MinWidth="820" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Icon="avares://MechWright.App/Assets/brand-chip.png"
        Background="#0B1014" Foreground="#E6ECEB">
  <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="11">
    <StackPanel Grid.Row="0" Spacing="3">
      <TextBlock Text="VANILLA MECHANOIDS / 原版机械体图鉴"
                 Foreground="#8DBCB4" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="只读资料来源：本机 Core 与已安装 DLC 的 XML。运行时 C# 数值和未处理补丁不会被猜测。"
                 Foreground="#A3B1B4" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#31434B" BorderThickness="1"
            Background="#151E24" CornerRadius="7" Padding="12">
      <views:VanillaLibraryView/>
    </Border>
  </Grid>
</Window>
